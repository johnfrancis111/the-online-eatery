# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/online-eatery?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins (your deployed frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173
